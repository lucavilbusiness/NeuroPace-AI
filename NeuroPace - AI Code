  document.getElementById('subProd').textContent      = lbl(last.r.produtividade, false);

  // status badge
  const st = statusFromScores(last.r.energia, last.r.burnout, last.r.bemestar);
  const badge = document.getElementById('statusBadge');
  badge.className = `status-badge ${st.cls} mb2`;
  badge.innerHTML = `<span class="icon">${st.icon}</span><span>${st.msg}</span>`;

  // --- LINE CHART ---
  if (lineChartInst) lineChartInst.destroy();
  const lineCtx = document.getElementById('lineChart').getContext('2d');
  lineChartInst = new Chart(lineCtx, {
    type:'line',
    data:{
      labels: data.map((d,i) => d.date || `Dia ${i+1}`),
      datasets:[
        { label:'Energia',      data:data.map(d=>d.r.energia),      borderColor:'#4ade80', backgroundColor:'rgba(74,222,128,0.07)',  tension:.4, fill:true, pointRadius:3 },
        { label:'Burnout',      data:data.map(d=>d.r.burnout),      borderColor:'#f43f5e', backgroundColor:'rgba(244,63,94,0.07)',   tension:.4, fill:true, pointRadius:3 },
        { label:'Bem-estar',    data:data.map(d=>d.r.bemestar),     borderColor:'#a78bfa', backgroundColor:'rgba(167,139,250,0.07)', tension:.4, fill:true, pointRadius:3 },
        { label:'Produtividade',data:data.map(d=>d.r.produtividade),borderColor:'#34d399', backgroundColor:'rgba(52,211,153,0.07)',  tension:.4, fill:true, pointRadius:3 },
      ]
    },
    options:{
      responsive:true,
      plugins:{ legend:{ labels:{ color:'#b0bac8', font:{ family:'DM Sans' }, boxWidth:12 } } },
      scales:{
        x:{ ticks:{ color:'#6b7a90', font:{size:11} }, grid:{ color:'#2a3240' } },
        y:{ ticks:{ color:'#6b7a90' }, grid:{ color:'#2a3240' }, max:100, min:0 }
      }
    }
  });

  // --- RADAR CHART ---
  if (radarChartInst) radarChartInst.destroy();
  const radarCtx = document.getElementById('radarChart').getContext('2d');
  radarChartInst = new Chart(radarCtx, {
    type:'radar',
    data:{
      labels:['Sono','Estresse','Carga','Tela','Fadiga','Foco','Humor','Motivação'],
      datasets:[{
        label:'Hoje',
        data:[ a.sono||0, a.estresse||0, a.carga||0, a.tela||0, a.fadiga||0, a.foco||0, a.humor||0, a.motivacao||0 ],
        borderColor:'#4ade80', backgroundColor:'rgba(74,222,128,0.15)', pointBackgroundColor:'#4ade80'
      }]
    },
    options:{
      responsive:true,
      plugins:{ legend:{ labels:{ color:'#b0bac8' } } },
      scales:{ r:{ ticks:{ color:'#6b7a90', backdropColor:'transparent' }, grid:{ color:'#2a3240' }, pointLabels:{ color:'#b0bac8', font:{ family:'DM Sans', size:11 } } } }
    }
  });

  // --- TOPIC CARDS (all 20 keys) ---
  const topicGrid = document.getElementById('topicCards');
  const keys = ['sono','horas_sono','energia_manha','exercicio','alimentacao','hidratacao',
                 'carga','foco','produtividade','estresse','ansiedade','humor','irritabilidade',
                 'tela','fadiga','pausas','social','motivacao','autocuidado','energia'];
  topicGrid.innerHTML = keys.filter(k => a[k] !== undefined).map(k => {
    const def = topicDefs[k];
    if (!def) return '';
    const val = a[k] || 0;
    const pct = Math.min(100, Math.round((val / def.max) * 100));
    const lvl = levelClass(val, def.max);
    return `<div class="topic-card">
      <div class="t-header">
        <span class="t-name">${def.icon} ${def.label}</span>
        <span class="t-val t-${lvl}">${pct}</span>
      </div>
      <div class="t-bar-bg"><div class="t-bar-fill fill-${lvl}" style="width:${pct}%"></div></div>
      <div class="t-reason">${def.desc(val)}</div>
    </div>`;
  }).join('');

  // --- LEGEND ---
  document.getElementById('legendGrid').innerHTML = legendDefs.map(l =>
    `<div class="legend-item">
      <span class="legend-icon">${l.icon}</span>
      <div class="legend-body">
        <div class="legend-title">${l.title}</div>
        <div class="legend-desc">${l.desc}</div>
      </div>
    </div>`
  ).join('');

  // --- HISTORY ---
  const list = document.getElementById('historyList');
  list.innerHTML = data.slice().reverse().map((d,i) =>
    `<li class="history-item">
      <span class="history-day">${d.date || 'Dia '+(data.length-i)}</span>
      <span class="history-vals">
        <span class="tag e">⚡ ${d.r.energia}</span>
        <span class="tag b">🔥 ${d.r.burnout}</span>
        <span class="tag w">💛 ${d.r.bemestar||'—'}</span>
        <span class="tag p">✅ ${d.r.produtividade||'—'}</span>
      </span>
    </li>`
  ).join('');
}

/* ============ AUTO LOGIN ============ */
const saved = localStorage.getItem('np_current');
if (saved) { currentUser = saved; startQuiz(); }
</script>
</body>

<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NeuroPace IA — Check-in Diário</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">

<style>
  :root {
    --bg:        #0d1117;
    --surface:   #161b22;
    --surface2:  #1e2530;
    --border:    #2a3240;
    --accent:    #4ade80;
    --accent2:   #f97316;
    --danger:    #f43f5e;
    --muted:     #6b7a90;
    --text:      #e8edf5;
    --text2:     #b0bac8;
    --radius:    16px;
    --font-head: 'Syne', sans-serif;
    --font-body: 'DM Sans', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow-x: hidden;
  }

  /* Animated background */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 20% 20%, rgba(74,222,128,0.06) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 80% 80%, rgba(249,115,22,0.05) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .wrapper {
    width: 100%;
    max-width: 560px;
    position: relative;
    z-index: 1;
  }

  /* ===== SCREEN (animated transitions) ===== */
  .screen {
    display: none;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .35s ease, transform .35s ease;
  }
  .screen.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== CARD ===== */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 36px 32px;
    box-shadow: 0 20px 60px rgba(0,0,0,.45);
  }

  /* ===== TYPOGRAPHY ===== */
  h1 {
    font-family: var(--font-head);
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  h2 {
    font-family: var(--font-head);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }
  h3 {
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--text2);
    text-transform: uppercase;
    letter-spacing: .07em;
    font-size: .78rem;
  }
  p { color: var(--text2); line-height: 1.6; }

  /* ===== LOGO BADGE ===== */
  .logo-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(74,222,128,.1);
    border: 1px solid rgba(74,222,128,.25);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: .82rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 24px;
    letter-spacing: .04em;
  }
  .logo-badge span { font-size: 1rem; }

  .hero-title { margin-bottom: 12px; }
  .hero-sub { font-size: .95rem; margin-bottom: 32px; }

  /* ===== INPUTS ===== */
  .field { margin-bottom: 14px; }
  .field label {
    display: block;
    font-size: .8rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  input[type="text"],
  input[type="password"] {
    width: 100%;
    padding: 12px 14px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-family: var(--font-body);
    font-size: .95rem;
    outline: none;
    transition: border-color .2s;
  }
  input:focus { border-color: var(--accent); }

  /* ===== BUTTONS ===== */
  .btn {
    width: 100%;
    padding: 13px 20px;
    border: none;
    border-radius: 10px;
    font-family: var(--font-head);
    font-size: .95rem;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: .02em;
    transition: transform .15s, opacity .15s;
  }
  .btn:active { transform: scale(.98); }
  .btn-primary {
    background: var(--accent);
    color: #0a1a0f;
  }
  .btn-primary:hover { opacity: .9; }
  .btn-secondary {
    background: var(--surface2);
    color: var(--text2);
    border: 1px solid var(--border);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .btn-ghost {
    background: transparent;
    color: var(--muted);
    text-decoration: underline;
    font-weight: 400;
    font-family: var(--font-body);
    font-size: .9rem;
  }

  .btn-row { display: flex; gap: 10px; margin-top: 10px; }
  .btn-row .btn { flex: 1; }

  .divider {
    display: flex; align-items: center; gap: 12px;
    margin: 22px 0;
    color: var(--muted); font-size: .82rem;
  }
  .divider::before, .divider::after {
    content: ''; flex: 1;
    height: 1px; background: var(--border);
  }

  .mt { margin-top: 12px; }
  .mt2 { margin-top: 20px; }
  .mb { margin-bottom: 8px; }

  /* ===== QUIZ ===== */
  .quiz-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .quiz-step {
    font-size: .8rem;
    color: var(--muted);
    font-weight: 500;
  }
  .progress-bar {
    width: 100%;
    height: 4px;
    background: var(--surface2);
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 28px;
  }
  .progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 99px;
    transition: width .4s cubic-bezier(.4,0,.2,1);
  }
  .quiz-question {
    font-family: var(--font-head);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 22px;
    line-height: 1.3;
  }
  .quiz-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .opt-btn {
    padding: 14px 12px;
    background: var(--surface2);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    font-family: var(--font-body);
    font-size: .9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all .18s;
    text-align: center;
  }
  .opt-btn:hover {
    border-color: var(--accent);
    background: rgba(74,222,128,.08);
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* ===== QUIZ BACK & EXIT ===== */
  .quiz-header-actions { display:flex; align-items:center; gap:10px; }
  .quiz-exit-btn {
    background:transparent; border:1px solid var(--border); border-radius:8px;
    color:var(--muted); font-family:var(--font-body); font-size:.78rem; font-weight:500;
    padding:5px 10px; cursor:pointer; transition:border-color .2s, color .2s; white-space:nowrap;
  }
  .quiz-exit-btn:hover { border-color:var(--danger); color:var(--danger); }
  .back-btn {
    margin-top:16px; width:100%; padding:11px;
    background:transparent; border:1.5px solid var(--border); border-radius:10px;
    color:var(--muted); font-family:var(--font-body); font-size:.88rem; font-weight:500;
    cursor:pointer; transition:border-color .2s, color .2s; letter-spacing:.01em;
  }
  .back-btn:hover { border-color:var(--accent); color:var(--accent); }
  /* ===== CONFIRM MODAL ===== */
  .modal-overlay {
    position:fixed; inset:0; background:rgba(0,0,0,.6); backdrop-filter:blur(4px);
    z-index:100; display:flex; align-items:center; justify-content:center;
    opacity:0; pointer-events:none; transition:opacity .25s;
  }
  .modal-overlay.open { opacity:1; pointer-events:all; }
  .modal-box {
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    padding:28px 26px; max-width:320px; width:90%; box-shadow:0 30px 80px rgba(0,0,0,.6);
    transform:translateY(16px); transition:transform .25s;
  }
  .modal-overlay.open .modal-box { transform:translateY(0); }
  .modal-box h4 { font-family:var(--font-head); font-size:1.1rem; font-weight:700; margin-bottom:8px; color:var(--text); }
  .modal-box p  { font-size:.88rem; color:var(--text2); margin-bottom:20px; }
  .modal-btns   { display:flex; gap:10px; }
  .modal-btns .btn { flex:1; }

  /* ===== QUIZ CAT LABEL ===== */
  .quiz-cat {
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .quiz-options.five {
    grid-template-columns: 1fr 1fr;
  }
  @media(min-width:400px){ .quiz-options.five { grid-template-columns: repeat(3,1fr); } }

  /* ===== DASH ===== */
  .score-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 20px;
  }
  .score-row.four {
    grid-template-columns: 1fr 1fr;
  }
  @media(min-width:480px){ .score-row.four { grid-template-columns: repeat(3,1fr); } }
  @media(min-width:700px){ .score-row.four { grid-template-columns: repeat(6,1fr); } }
  .score-card {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
    position: relative;
    overflow: hidden;
  }
  .score-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
  }
  .score-card.energy::before { background: var(--accent); }
  .score-card.burnout::before { background: var(--danger); }
  .score-card .label {
    font-size: .75rem;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: 8px;
  }
  .score-card .value {
    font-family: var(--font-head);
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1;
  }
  .score-card.energy .value { color: var(--accent); }
  .score-card.burnout .value { color: var(--danger); }
  .score-card.focus::before  { background: #60a5fa; }
  .score-card.stress::before { background: #f97316; }
  .score-card.focus .value   { color: #60a5fa; }
  .score-card.wellbeing::before  { background: #a78bfa; }
  .score-card.productivity::before { background: #34d399; }
  .score-card.wellbeing .value   { color: #a78bfa; }
  .score-card.productivity .value{ color: #34d399; }
  .score-card.stress .value  { color: #f97316; }
  .score-sub {
    font-size: .72rem;
    color: var(--muted);
    margin-top: 4px;
    font-weight: 500;
  }

  /* ===== STATUS BADGE ===== */
  .status-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-radius: 12px;
    font-size: .88rem;
    font-weight: 500;
    line-height: 1.45;
    margin-bottom: 24px;
  }
  .status-badge .icon { font-size: 1.4rem; flex-shrink: 0; }
  .status-badge.ok   { background:rgba(74,222,128,.1);  border:1px solid rgba(74,222,128,.25); color:#a7f3c0; }
  .status-badge.warn { background:rgba(249,115,22,.1);  border:1px solid rgba(249,115,22,.25); color:#fed7aa; }
  .status-badge.bad  { background:rgba(244,63,94,.1);   border:1px solid rgba(244,63,94,.25);  color:#fca5b4; }

  /* ===== TOPIC CARDS ===== */
  .topic-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 4px;
  }
  .topic-card {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    transition: border-color .2s;
  }
  .topic-card:hover { border-color: #3a4560; }
  .topic-card .t-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; }
  .topic-card .t-name { font-size:.78rem; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); font-weight:600; }
  .topic-card .t-val  { font-family:var(--font-head); font-size:1.1rem; font-weight:800; }
  .topic-card .t-bar-bg { height:4px; background:var(--border); border-radius:99px; overflow:hidden; margin-bottom:7px; }
  .topic-card .t-bar-fill { height:100%; border-radius:99px; transition:width .6s ease; }
  .topic-card .t-reason { font-size:.78rem; color:var(--text2); line-height:1.4; }
  .t-low  { color: var(--accent); }
  .t-mid  { color: #facc15; }
  .t-high { color: var(--danger); }
  .fill-low  { background: var(--accent); }
  .fill-mid  { background: #facc15; }
  .fill-high { background: var(--danger); }

  /* ===== LEGEND ===== */
  .legend-grid { display:grid; gap:8px; margin-bottom:4px; }
  .legend-item { background:var(--surface2); border:1px solid var(--border); border-radius:10px; padding:12px 14px; display:flex; gap:12px; align-items:flex-start; }
  .legend-icon { font-size:1.2rem; flex-shrink:0; padding-top:1px; }
  .legend-title { font-family:var(--font-head); font-size:.85rem; font-weight:700; color:var(--text); margin-bottom:3px; }
  .legend-desc  { font-size:.78rem; color:var(--muted); line-height:1.45; }

  .mb2 { margin-bottom: 24px; }

  .chart-wrap {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 14px;
  }

  .history-list { list-style: none; }
  .history-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: .88rem;
  }
  .history-item:last-child { border-bottom: none; }
  .history-day { color: var(--muted); font-weight: 500; }
  .history-vals { display: flex; gap: 16px; }
  .tag {
    font-size: .75rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 99px;
  }
  .tag.e { background: rgba(74,222,128,.15); color: var(--accent); }
  .tag.b { background: rgba(244,63,94,.15); color: var(--danger); }
  .tag.w { background: rgba(167,139,250,.15); color: #a78bfa; }
  .tag.p { background: rgba(52,211,153,.15);  color: #34d399; }

  /* ===== LOGOUT ===== */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .user-pill {
    font-size: .82rem;
    color: var(--muted);
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 99px;
    padding: 5px 12px;
  }
  .logout-btn {
    font-size: .82rem;
    color: var(--muted);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
    font-family: var(--font-body);
  }
  .logout-btn:hover { color: var(--danger); }

  /* ===== ALERT ===== */
  .alert {
    padding: 11px 14px;
    border-radius: 10px;
    font-size: .88rem;
    margin-bottom: 14px;
    display: none;
  }
  .alert.err { background: rgba(244,63,94,.12); color: var(--danger); border: 1px solid rgba(244,63,94,.25); }
  .alert.ok  { background: rgba(74,222,128,.12); color: var(--accent); border: 1px solid rgba(74,222,128,.25); }
  .alert.show { display: block; }

  canvas { max-width: 100%; }
</style>
</head>
<body>
<div class="wrapper">

  <!-- ========== HOME ========== -->
  <div class="screen active" id="homeScreen">
    <div class="card">
      <div class="logo-badge"><span>🧠</span> NeuroPace IA</div>
      <h1 class="hero-title">Seu check-in<br>mental diário.</h1>
      <p class="hero-sub">Acompanhe sono, foco, energia e burnout — tudo em menos de 2 minutos.</p>
      <button class="btn btn-primary" onclick="goTo('authScreen')">Começar agora</button>
    </div>
  </div>

  <!-- ========== AUTH ========== -->
  <div class="screen" id="authScreen">
    <div class="card">
      <h2>Acesse sua conta</h2>

      <div id="authAlert" class="alert"></div>

      <div id="loginForm">
        <div class="field">
          <label>Usuário</label>
          <input type="text" id="li_user" placeholder="seu usuário">
        </div>
        <div class="field">
          <label>Senha</label>
          <input type="password" id="li_pass" placeholder="••••••••">
        </div>
        <button class="btn btn-primary mt" onclick="login()">Entrar</button>
        <div class="divider">ou</div>
        <button class="btn btn-secondary" onclick="toggleForm('signup')">Criar conta nova</button>
      </div>

      <div id="signupForm" style="display:none">
        <div class="field">
          <label>Usuário</label>
          <input type="text" id="su_user" placeholder="escolha um usuário">
        </div>
        <div class="field">
          <label>Senha</label>
          <input type="password" id="su_pass" placeholder="••••••••">
        </div>
        <button class="btn btn-primary mt" onclick="signup()">Criar conta</button>
        <div class="divider">ou</div>
        <button class="btn btn-secondary" onclick="toggleForm('login')">Já tenho conta</button>
      </div>

      <button class="btn btn-ghost mt2" onclick="goTo('homeScreen')">← Voltar</button>
    </div>
  </div>

  <!-- ========== QUIZ ========== -->
  <div class="screen" id="quizScreen">
    <div class="card">
      <div class="quiz-header">
        <span class="logo-badge" style="margin:0"><span>🧠</span> NeuroPace</span>
        <div class="quiz-header-actions">
          <span class="quiz-step" id="stepLabel">1 / 20</span>
          <button class="quiz-exit-btn" onclick="confirmLogout()" title="Sair da conta">⏻ Sair</button>
        </div>
      </div>
      <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
      <div class="quiz-question" id="quizQ"></div>
      <div class="quiz-options" id="quizOpts"></div>
      <button class="back-btn" id="backBtn" onclick="goBack()" style="display:none">← Voltar</button>
    </div>
  </div>

  <!-- ========== DASH ========== -->
  <div class="screen" id="dashScreen">
    <div class="card">
      <div class="top-bar">
        <span class="user-pill" id="userPill">👤 —</span>
        <button class="logout-btn" onclick="logout()">Sair</button>
      </div>

      <h2>📊 Seu relatório</h2>

      <!-- 4-card top row -->
      <div class="score-row four">
        <div class="score-card energy">
          <div class="label">Energia</div>
          <div class="value" id="scoreEnergy">—</div>
          <div class="score-sub" id="subEnergy"></div>
        </div>
        <div class="score-card burnout">
          <div class="label">Burnout</div>
          <div class="value" id="scoreBurnout">—</div>
          <div class="score-sub" id="subBurnout"></div>
        </div>
        <div class="score-card focus">
          <div class="label">Foco</div>
          <div class="value" id="scoreFoco">—</div>
          <div class="score-sub" id="subFoco"></div>
        </div>
        <div class="score-card stress">
          <div class="label">Estresse</div>
          <div class="value" id="scoreEstresse">—</div>
          <div class="score-sub" id="subEstresse"></div>
        </div>
        <div class="score-card wellbeing">
          <div class="label">Bem-estar</div>
          <div class="value" id="scoreBemestar">—</div>
          <div class="score-sub" id="subBemestar"></div>
        </div>
        <div class="score-card productivity">
          <div class="label">Produtividade</div>
          <div class="value" id="scoreProd">—</div>
          <div class="score-sub" id="subProd"></div>
        </div>
      </div>

      <!-- Status geral badge -->
      <div id="statusBadge" class="status-badge mb2"></div>

      <h3>Evolução</h3>
      <div class="chart-wrap mb">
        <canvas id="lineChart" height="160"></canvas>
      </div>

      <h3>Radar de hoje</h3>
      <div class="chart-wrap mb">
        <canvas id="radarChart" height="220"></canvas>
      </div>

      <!-- Análise por tópico -->
      <h3>Análise detalhada</h3>
      <div id="topicCards" class="topic-grid"></div>

      <!-- Legenda dos tópicos -->
      <h3 style="margin-top:24px">O que cada tópico significa?</h3>
      <div class="legend-grid" id="legendGrid"></div>

      <h3 style="margin-top:24px">Histórico</h3>
      <ul class="history-list" id="historyList"></ul>

      <button class="btn btn-primary mt2" onclick="startQuiz()">Novo check-in</button>
    </div>
  </div>

</div>

<!-- ========== LOGOUT MODAL ========== -->
<div class="modal-overlay" id="logoutModal">
  <div class="modal-box">
    <h4>Sair da conta?</h4>
    <p>Seu progresso do check-in atual será perdido. Tem certeza?</p>
    <div class="modal-btns">
      <button class="btn btn-secondary" onclick="closeModal()">Cancelar</button>
      <button class="btn btn-primary" style="background:var(--danger);color:#fff" onclick="logout()">Sair</button>
    </div>
  </div>
</div>

<script>
/* ============ STATE ============ */
let currentUser = null;
let step = 0;
let answers = {};
let lineChartInst = null;
let radarChartInst = null;

/* ============ QUESTIONS ============ */

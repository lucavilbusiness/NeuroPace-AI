/* ============ HELPERS ============ */
function levelClass(val, max) {
  const pct = val / max;
  if (pct <= 0.4) return 'low';
  if (pct <= 0.7) return 'mid';
  return 'high';
}

function statusFromScores(energia, burnout, bemestar) {
  if (energia >= 70 && burnout <= 35 && bemestar >= 70) return { cls:'ok',  icon:'✅', msg:'Dia excelente! Energia alta, burnout baixo e bem-estar elevado. Ótimo momento para tarefas exigentes e conexões importantes.' };
  if (energia >= 70 && burnout <= 40) return { cls:'ok',  icon:'✅', msg:'Você está bem hoje! Energia alta e risco de burnout baixo. Ótimo momento para tarefas que exigem foco.' };
  if (burnout >= 75)                  return { cls:'bad', icon:'🚨', msg:'Sinal crítico: burnout muito alto. Priorize descanso completo, evite novas demandas e considere falar com alguém.' };
  if (burnout >= 60)                  return { cls:'bad', icon:'⚠️', msg:'Burnout elevado detectado. Reduza a carga de trabalho, aumente pausas e cuide do sono esta noite.' };
  if (energia <= 30)                  return { cls:'bad', icon:'🪫', msg:'Energia crítica. Evite decisões importantes, priorize descanso e verifique sono, alimentação e hidratação.' };
  if (bemestar <= 35)                 return { cls:'warn', icon:'💛', msg:'Bem-estar emocional baixo hoje. Tente se conectar com alguém de confiança ou fazer algo que te dê prazer.' };
  return { cls:'warn', icon:'⚠️', msg:'Dia moderado. Há pontos de atenção — veja a análise detalhada abaixo para entender onde focar.' };
}


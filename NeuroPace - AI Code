/* ============ NAVIGATION ============ */
function goTo(id) {
  document.querySelectorAll('.screen').forEach(s => {
    s.classList.remove('active');
    s.style.display = 'none';
  });
  const el = document.getElementById(id);
  el.style.display = 'block';
  // force reflow for animation
  requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('active')));
}

/* ============ ALERT ============ */
function showAlert(msg, type = 'err') {
  const el = document.getElementById('authAlert');
  el.textContent = msg;
  el.className = `alert ${type} show`;
  setTimeout(() => el.classList.remove('show'), 3500);
}

/* ============ FORM TOGGLE ============ */
function toggleForm(which) {
  document.getElementById('loginForm').style.display  = which === 'login'  ? 'block' : 'none';
  document.getElementById('signupForm').style.display = which === 'signup' ? 'block' : 'none';
}

/* ============ USERS ============ */
function getUsers() { return JSON.parse(localStorage.getItem('np_users') || '{}'); }
function saveUsers(u) { localStorage.setItem('np_users', JSON.stringify(u)); }

/* ============ AUTH ============ */
function signup() {
  const u = document.getElementById('su_user').value.trim();
  const p = document.getElementById('su_pass').value.trim();
  if (!u || !p) return showAlert('Preencha usuário e senha.');
  const users = getUsers();
  if (users[u]) return showAlert('Esse usuário já existe.');
  users[u] = { password: p };
  saveUsers(users);
  showAlert('Conta criada! Faça login.', 'ok');
  toggleForm('login');
}

function login() {
  const u = document.getElementById('li_user').value.trim();
  const p = document.getElementById('li_pass').value.trim();
  const users = getUsers();
  if (!users[u] || users[u].password !== p) return showAlert('Usuário ou senha inválidos.');
  currentUser = u;
  localStorage.setItem('np_current', u);
  startQuiz();
}

function logout() {
  currentUser = null;
  localStorage.removeItem('np_current');
  goTo('homeScreen');
}

/* ============ QUIZ ============ */
function startQuiz() {
  step = 0;
  answers = {};
  goTo('quizScreen');
  renderQ();
}

function renderQ() {
  const pct = (step / questions.length) * 100;
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('stepLabel').textContent = `${step + 1} / ${questions.length}`;
  const q = questions[step];
  const catLabel = q.cat ? `<div class="quiz-cat">${q.cat}</div>` : '';
  document.getElementById('quizQ').innerHTML = catLabel + q.q;
  const isFive = q.opts.length === 5;
  document.getElementById('quizOpts').className = isFive ? 'quiz-options five' : 'quiz-options';
  document.getElementById('quizOpts').innerHTML = q.opts.map(o =>
    `<button class="opt-btn" onclick="answer(${o[1]})">${o[0]}</button>`
  ).join('');
}

function answer(v) {
  answers[questions[step].key] = v;
  step++;
  if (step >= questions.length) finish();
  else renderQ();
}

/* ============ SCORE ============ */
function calcScores(a) {
  const g = (v) => v || 0;
  // Energia: sono, horas_sono, energia_manha, energia, exercicio, alimentacao, hidratacao
  const energiaRaw = g(a.sono) + g(a.horas_sono) + g(a.energia_manha) + g(a.energia) + g(a.exercicio) + g(a.alimentacao) + g(a.hidratacao);
  const energia = Math.min(100, Math.round(energiaRaw * 100 / 70));
  // Burnout: estresse, ansiedade, fadiga, carga, irritabilidade
  const burnoutRaw = g(a.estresse) + g(a.ansiedade) + g(a.fadiga) + (g(a.carga) > 10 ? 10 : g(a.carga)) + (10 - g(a.irritabilidade)/10*10);
  const burnout = Math.min(100, Math.round((g(a.estresse) + g(a.ansiedade) + g(a.fadiga)) * 100 / 30));
  // Bem-estar: humor, social, motivacao, autocuidado
  const bemestarRaw = g(a.humor) + g(a.social) + g(a.motivacao) + g(a.autocuidado);
  const bemestar = Math.min(100, Math.round(bemestarRaw * 100 / 40));
  // Produtividade: foco, produtividade, pausas, carga
  const prodRaw = g(a.foco) + g(a.produtividade) + g(a.pausas);
  const produtividade = Math.min(100, Math.round(prodRaw * 100 / 30));
  return { burnout, energia, bemestar, produtividade };
}

/* ============ FINISH ============ */
function finish() {
  const r = calcScores(answers);
  const key = currentUser + '_data';
  const data = JSON.parse(localStorage.getItem(key) || '[]');
  data.push({ answers, r, date: new Date().toLocaleDateString('pt-BR') });
  localStorage.setItem(key, JSON.stringify(data));
  showDash();
}

